    "c001",
    "c076"
   ],
   "note": "Русский обходится без «is», английский — нет: «такси быстрое» → the taxi IS fast.",
   "difficulty": 1
  },
  {
   "id": "p02",
   "schema": "I don't {verb} {noun}.",
   "ru_schema": "Я не {глагол} {существительное}.",
